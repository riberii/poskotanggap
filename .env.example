# Salin ke .env.local. Jangan commit nilai asli.
# Supabase (opsional; tanpa ini aplikasi berjalan dalam mode mock tanpa login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (server-side saja). Di Netlify, GEMINI_API_KEY disuntik otomatis oleh AI Gateway.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Izinkan ekstraksi AI di mode mock tanpa login (hanya untuk demo lokal).
AI_EXTRACTION_ALLOW_MOCK_MODE=false

# Salin ke .env untuk pengembangan lokal. JANGAN commit .env.
# Kunci Gemini dibaca hanya oleh server (npm run dev / Netlify Function), tidak pernah dikirim ke browser.
# Di Netlify, AI Gateway menyuntik kredensial otomatis; variabel ini opsional di sana.
GEMINI_API_KEY=
# Opsional. Default: gemini-3.5-flash
GEMINI_MODEL=

# Salin ke .env.local dan isi. JANGAN commit file .env.local.
# Jika dua variabel Supabase di bawah kosong, aplikasi berjalan dalam MODE MOCK
# (data simulasi in-memory, tanpa login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 3 (belum dipakai). Hanya server-side, jangan beri prefix NEXT_PUBLIC_.
GEMINI_API_KEY=

# Service-role key TIDAK dipakai oleh aplikasi. Jangan ditambahkan di sini.

# Salin ke .env untuk pengembangan lokal. JANGAN commit .env. Isi nilai asli di Netlify (Site settings → Environment variables).

# Gerbang operator (wajib di produksi; bila kosong, halaman/endpoint tim TERTUTUP)
OPERATOR_PASSCODE=
SESSION_SECRET=          # string acak minimal 16 karakter, mis. keluaran `openssl rand -hex 32`

# AI (opsional; di Netlify, AI Gateway menyuntikkan kredensial otomatis)
GEMINI_API_KEY=
GEMINI_MODEL=
